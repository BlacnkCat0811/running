{
  "name": "rai-running-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "pretypecheck": "node scripts/check-node-version.mjs",
    "pretest": "node scripts/check-node-version.mjs",
    "prebuild": "node scripts/check-node-version.mjs",
    "predev": "node scripts/check-node-version.mjs",
    "predev:api": "npm run check:node",
    "predev:web": "npm run check:node",
    "prestart": "node scripts/check-node-version.mjs && node scripts/check-web-build.mjs",
    "presmoke:api": "node scripts/check-node-version.mjs",
    "predata:import": "npm run check:node",
    "predata:incremental-import": "npm run check:node",
    "predata:audit": "npm run check:node",
    "predata:recompute": "npm run check:node",
    "predata:refresh-snapshots": "npm run check:node",
    "predata:analyze": "npm run check:node",
    "predata:predict": "npm run check:node",
    "predata:prediction-eval": "npm run check:node",
    "preml:bootstrap": "npm run check:node",
    "preml:check": "npm run check:node",
    "preml:install": "npm run check:node",
    "preml:test": "npm run check:node",
    "preml:train": "npm run check:node",
    "typecheck": "tsc --noEmit -p tsconfig.pure.json && tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test packages/*/test/*.test.ts apps/api/test/*.test.ts; node_status=$?; npm run test -w @rai/web; web_status=$?; test $node_status -eq 0 -a $web_status -eq 0",
    "test:e2e:web": "npm run build && node --import tsx --test --test-concurrency=1 apps/web/e2e/web-flows.test.ts",
    "test:e2e:responsive": "npm run build && node --import tsx --test --test-concurrency=1 apps/web/e2e/web-flows.test.ts",
    "test:e2e": "npm run test:e2e:web && npm run test:e2e:responsive",
    "test:all": "npm run typecheck && npm test && npm run ml:test && npm run test:e2e:web",
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w @rai/api\" \"npm run dev -w @rai/web\"",
    "dev:device": "node scripts/dev-device.mjs",
    "dev:api": "npm run dev -w @rai/api",
    "dev:web": "npm run dev -w @rai/web",
    "open:ios": "open apps/ios/RAI.xcworkspace",
    "build": "npm run build -w @rai/web",
    "start": "npm run start -w @rai/api",
    "smoke:api": "node apps/api/test/production-runtime-smoke.mjs",
    "data:import": "tsx packages/health-export-parser/src/cli.ts import",
    "data:incremental-import": "tsx packages/health-export-parser/src/cli.ts incremental-import",
    "data:audit": "tsx packages/health-export-parser/src/cli.ts audit",
    "data:recompute": "tsx packages/application/src/cli.ts recompute",
    "data:refresh-snapshots": "tsx packages/application/src/cli.ts refresh-snapshots",
    "data:analyze": "tsx packages/application/src/analyze-cli.ts",
    "data:predict": "tsx packages/application/src/prediction-cli.ts",
    "data:prune-tombstones": "tsx packages/health-export-parser/src/prune-tombstones-cli.ts",
    "predata:prune-tombstones": "npm run check:node",
    "data:prediction-eval": "tsx packages/application/src/prediction-eval-cli.ts",
    "ml:bootstrap": "node research/scripts/python-env.mjs --bootstrap",
    "ml:check": "node research/scripts/python-env.mjs --check",
    "ml:install": "npm run ml:bootstrap",
    "ml:test": "node research/scripts/python-env.mjs --pytest",
    "ml:train": "node research/scripts/python-env.mjs --train",
    "predata:migrate": "npm run check:node",
    "data:migrate": "tsx packages/storage-sqlite/src/migrate-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    }
  }
}
