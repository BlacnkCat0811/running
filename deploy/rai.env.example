# Single cloud host: 2 vCPU / 2 GiB. Install root-readable only (0600).
RAI_API_HOST=127.0.0.1
RAI_API_PORT=8787
RAI_API_TOKEN=replace-with-a-long-random-token
RAI_RUNTIME_ROOT=/var/lib/rai
RAI_DATABASE=/var/lib/rai/var/rai.sqlite
RAI_CONTROL_DATABASE=/var/lib/rai/var/rai-control.sqlite
RAI_LOG_LEVEL=info
RAI_IMPORT_MAX_ZIP_BYTES=4294967296
# Extra incremental-vs-full replay comparison: shadow (safe default) or off.
# off never disables the model activation gate. Benchmark on a copy before opting in.
RAI_IMPORT_VALIDATION_MODE=shadow
# Native decoder is opt-in until your real-data parity/performance gate passes.
RAI_IMPORT_ENGINE=typescript
RAI_RUST_FALLBACK=none
# RAI_RUST_BINARY=/opt/rai/target/release/rai-data-worker
# Public HTTPS host via local Nginx; Bearer authentication remains required.
RAI_ALLOW_REMOTE_TOKEN_AUTH=1
RAI_ALLOWED_ORIGINS=https://rai.example.com
# Preserve existing identities/token when upgrading the same dataset.
RAI_SERVER_ID=local
RAI_ATHLETE_ID=athlete_1
RAI_DATASET_EPOCH=default
# 匿名只读：允许无令牌读取公开读路由的 Host，逗号分隔，不带端口。
# 留空 = 每个 /v1 请求都要 Token（默认安全姿态）。
# Nginx 用 `proxy_set_header Host $host` 转发，所以这里填域名本身；
# 用 IP 直连站点时（备案期）还要把公网 IP 一并列上。
# 公开的只有健康数据读接口：写请求与备份/诊断/导入源等敏感读接口始终要 Token。
RAI_PUBLIC_HOSTS=
# 备份保留策略（生产覆盖值；代码默认 10 份 / 20 GiB / 512 MiB）
RAI_BACKUP_MAX_COUNT=14
RAI_BACKUP_MAX_TOTAL_BYTES=10737418240
RAI_BACKUP_MIN_FREE_BYTES=1073741824
# Per Node process/isolate, not a limit on all processes or total RSS.
# The systemd cgroup additionally limits the aggregate service memory.
NODE_OPTIONS=--max-old-space-size=512
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
