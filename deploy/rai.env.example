# Single cloud host: 2 vCPU / 2 GiB. Install root-readable only (0600).
RAI_API_HOST=127.0.0.1
RAI_API_PORT=8787
RAI_API_TOKEN=replace-with-a-long-random-token
# 阶段 4：整 runtime 冷备（deploy/backup-runtime.sh）只归档 RAI_RUNTIME_ROOT。
# RAI_DATABASE / RAI_CONTROL_DATABASE 必须在本文件中**显式**给出；用
# --env-file 备份时不能再用 CLI 库路径覆盖。仅当 service 完全不用
# EnvironmentFile、改用 Environment= 明确声明三个路径时，才可同时传
# --database/--control-database。缺一个、路径在根外或出现权威链接都会拒绝。
# 不要省略这两个键再依赖代码默认值：API 的缺省主库是 <projectRoot>/var/rai.sqlite。
RAI_RUNTIME_ROOT=/var/lib/rai
RAI_DATABASE=/var/lib/rai/var/rai.sqlite
RAI_CONTROL_DATABASE=/var/lib/rai/var/rai-control.sqlite
RAI_LOG_LEVEL=info
# 部署模式：设为 cloud 时 /v1/health 的 localOnly=false；缺省视为本地开发（localOnly=true）。
# 不改变鉴权（Token 仍必须配置），只影响 health 的自述字段与排障判断。
RAI_DEPLOYMENT_MODE=cloud
# 单批上传 ZIP 上界（S3.6 起默认 64 MiB；iOS 分批后单批 ≤ ~34 MiB + 包壳，留 ≥1.9× 余量）。
# 老客户端的一次性大包会被拒（413 语义）—— 分批版 iOS 是正常同步的前置。
RAI_IMPORT_MAX_ZIP_BYTES=67108864
# (2026-09-20) RAI_IMPORT_VALIDATION_MODE was removed together with the shadow
# full-replay comparison. The model activation gate is a separate mechanism and
# always stays enabled; there is no longer a variable that can weaken it.
# Native decoder is opt-in for CLI/benchmark only. The API import lanes require
# TypeScript: setting this to `rust` makes every API import fail with engine_<name>
# (client code direct_sync_unavailable). Keep this at typescript in cloud.
RAI_IMPORT_ENGINE=typescript
# Eligible v2 record-only deltas use one live-DB transaction. 0 pauses the direct
# lanes: they fail explicitly (fast_path_disabled / direct_sync_unavailable); the
# old backup/candidate/file-swap path was removed from the API at runtime.
RAI_IMPORT_DATA_ONLY_FAST_PATH=1
# 🔴 Leave this at `typescript` when you turn the engine on. Fallback only covers two reasons
# ("unavailable" and "unsupported_xml": non-ASCII tag names, a DTD with entity definitions,
# non-standard GPX dates) and only BEFORE any decoded row is applied — so it can never produce
# a half-Rust/half-TS dataset. Real bad data (`invalid_xml`) and resource limits still fail.
# With `none` an unsupported export makes the import job FAIL outright rather than fall back;
# `none` exists for benchmarks, so a TS fallback cannot be mistaken for Rust performance.
# See packages/health-export-parser/src/native-worker.ts:173 and apps/api/src/import-worker.ts:573.
RAI_RUST_FALLBACK=typescript
# 🔴 Set this in the SAME batch as RAI_IMPORT_ENGINE=rust. The built-in default resolves to
# <repo>/target/release/rai-data-worker, but the cloud host keeps the artifact OUTSIDE the
# repo (/opt/rai-native) so a redeploy cannot wipe it — so that default path will NOT exist.
# rust + fallback=none + missing binary makes the API fail to START (server.ts throws at
# module top level); it does not fall back to TypeScript. Build it in place first:
# docs/RUST_DATA_ENGINE.md「云服务器就地构建」。
# RAI_RUST_BINARY=/opt/rai-native/rai-data-worker
# Public HTTPS host via local Nginx; Bearer authentication remains required.
RAI_ALLOW_REMOTE_TOKEN_AUTH=1
RAI_ALLOWED_ORIGINS=https://rai.example.com
# Preserve existing identities/token when upgrading the same dataset.
RAI_SERVER_ID=local
RAI_ATHLETE_ID=athlete_1
RAI_DATASET_EPOCH=default
# 匿名只读：允许无令牌读取**探活/版本路由**的 Host，逗号分隔，不带端口。
# 原为浏览器 Web 的「打开即看」而设；Web 已于 2026-10-17 退役，默认不需要。
# 2026-10-18 起匿名只读范围收敛为 3 条且**不含任何健康数据**：
#   GET /v1/health、GET /v1/handshake、GET /v1/runtime-status
# 所有健康数据读（含 /v1/mobile/*、/v1/workouts、/v1/trends、/v1/model-* 等）
# 与全部写请求一律需要 Token。别把这一项当成"公开健康数据"的开关。
# 留空 = 每个 /v1 请求都要 Token（默认安全姿态）。
# Nginx 用 `proxy_set_header Host $host` 转发，所以这里填域名本身；
# 用 IP 直连站点时（备案期）还要把公网 IP 一并列上。
# 备份/诊断/导入源等敏感读接口始终要 Token，即使 Host 在这里列出。
RAI_PUBLIC_HOSTS=
# 备份保留策略（生产覆盖值；代码默认 10 份 / 20 GiB / 512 MiB）
RAI_BACKUP_MAX_COUNT=14
RAI_BACKUP_MAX_TOTAL_BYTES=10737418240
RAI_BACKUP_MIN_FREE_BYTES=1073741824
# Per Node process/isolate, not a limit on all processes or total RSS.
# The systemd cgroup additionally limits the aggregate service memory.
NODE_OPTIONS=--max-old-space-size=512
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
