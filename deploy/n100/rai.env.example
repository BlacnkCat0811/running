# Home VM profile. Install as /etc/rai/rai.env, mode 0600, outside the repository.
# All persistent state must stay under RAI_RUNTIME_ROOT for whole-runtime backups.
RAI_API_HOST=127.0.0.1
RAI_API_PORT=8787
RAI_API_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_API_TOKEN
RAI_RUNTIME_ROOT=/var/lib/rai
RAI_DATABASE=/var/lib/rai/var/rai.sqlite
RAI_CONTROL_DATABASE=/var/lib/rai/var/rai-control.sqlite
RAI_LOG_LEVEL=info
RAI_IMPORT_MAX_ZIP_BYTES=4294967296
RAI_IMPORT_VALIDATION_MODE=shadow
RAI_IMPORT_ENGINE=typescript
RAI_RUST_FALLBACK=none
# RAI_RUST_BINARY=/opt/rai/target/release/rai-data-worker
# Required when requests retain the public Host through the FRP TCP tunnel.
RAI_ALLOW_REMOTE_TOKEN_AUTH=1
RAI_ALLOWED_ORIGINS=https://rai.example.com
# Never publish health/route data anonymously just to make the Web UI work.
RAI_PUBLIC_HOSTS=
# Preserve the existing values on migration to keep iOS anchor/cache scope.
RAI_SERVER_ID=local
RAI_ATHLETE_ID=athlete_1
RAI_DATASET_EPOCH=default
RAI_BACKUP_MAX_COUNT=14
RAI_BACKUP_MAX_TOTAL_BYTES=10737418240
RAI_BACKUP_MIN_FREE_BYTES=2147483648
# Per Node process/isolate, NOT a total memory ceiling for the service.
NODE_OPTIONS=--max-old-space-size=1024
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
