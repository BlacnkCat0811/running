[Unit]
Description=FRP %i tunnel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=frp
Group=frp
ExecStartPre=/usr/local/bin/%i verify -c /etc/frp/%i.toml
ExecStart=/usr/local/bin/%i -c /etc/frp/%i.toml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=256M
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
