[Unit]
Description=RAI running intelligence API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# 2026-10-18（生产 -1001 复盘 lane C）：Restart=on-failure 只救「进程退出」，救不了
# 「进程活着但事件循环被占住」——那种 hang 此前只能等人工发现。改为 systemd watchdog：
# Type=notify 让 systemd 等到 API 真正 listen 后才算启动成功；WatchdogSec 让心跳超时
# 也能被判失败并按 Restart=on-failure 重启。
#
# API 侧契约（发送端在 apps/api/src，本模板只声明期望）：
#   · listen 成功后发 READY=1（否则 Type=notify 会在 TimeoutStartSec 后判启动失败）
#   · 之后每 40 s 发一次 WATCHDOG=1（40 s = WatchdogSec 120 s 的三分之一）
#   · 关闭时发 STOPPING=1
#   · 没有 NOTIFY_SOCKET（本地开发 / 非 systemd 启动）时以上全部 no-op
# 发送方式：Node 进程 spawn /usr/bin/systemd-notify（子进程发消息，故 NotifyAccess=all；
# 默认 NotifyAccess=main 会丢弃子进程的 sd_notify 消息）。
Type=notify
NotifyAccess=all
WatchdogSec=120
User=rai
Group=rai
WorkingDirectory=/opt/rai
EnvironmentFile=/etc/rai/rai.env
ExecStartPre=/usr/bin/node scripts/check-node-version.mjs
# Supervise Node directly: preserve exit 78 and deliver SIGTERM to the API.
ExecStart=/usr/bin/node --import tsx apps/api/src/server.ts
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=120
KillMode=mixed
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rai
UMask=0077
LimitNOFILE=16384
# Starting limits for a dedicated 2 vCPU / 2 GiB cloud host.
# Aggregate API + workers + trainer, NOT per-process memory allowances.
MemoryHigh=1100M
MemoryMax=1400M
MemorySwapMax=512M
CPUQuota=150%
TasksMax=128

[Install]
WantedBy=multi-user.target
