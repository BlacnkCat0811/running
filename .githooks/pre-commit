#!/usr/bin/env bash
# Local guard for a repository whose CI is not wired to its remote (gitee).
# Catches type regressions before commit; the full `npm run test:all` gate
# still belongs to CI / a pre-push manual run.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 仓库体积闸门：单个已跟踪文件不得超过 1.5 MB。触发面**刻意不收窄** —— 大文件可以从任何
# 目录进来，而上一轮正是「在一个目录里清掉、又在另一个新目录复发」（27 MB 的 4K 设计板）。
# 这条是路径无关的字节上限，每次提交都跑（毫秒级）。为什么用字节上限而不是 `.gitignore`
# 模式（会静默拦掉验收截图），见 scripts/check-blob-size.mjs 头注释。
node scripts/check-blob-size.mjs

npm run typecheck
npm run check:docs

# npm script 的跨平台语法闸门（`&&`、纯命令、`node xxx.mjs` 之外的写法一律拦下：
# `;`、`$?`、`VAR=x cmd`、`test`、`[ ]`、`uname`、`$VAR`、依赖 shell 展开的 `*`、`./x.sh`）。
# 每一条都真的坏过一次，坏法都是"Mac 上好好的、Windows 上是红的"。毫秒级，每次提交都跑。
node scripts/check-npm-scripts-portable.mjs

# iOS 判据（typecheck-ios.sh + run-model-tests.sh）此前没有任何自动入口，
# 只有人记得的时候才会被跑 —— 2026-09-19 的 test11 回归就是这么进主干的。
# 触发面刻意收窄到 `apps/ios/`：iOS 门禁要真编译全部 Swift 源码，秒级变分钟级，
# 而绝大多数提交动的是 TS。
#
# 这里不做环境判断：`npm run test:ios` 自己会发现"非 macOS / 没有 Xcode"，
# 打印「本次没有检查任何 iOS 源码」并跳过。把判断放一处，避免两边的条件漂移。
#
# 🔴 但「跑门禁可以跳过」与「提交可以放行」是两件事 —— 2026-10-13 付过代价：
# `60678af` 在 Windows 上提交，`npm run test:ios` 按设计打印跳过并 **exit 0**
# （`apps/ios/tests/run-ios-gates.sh` 判 `uname -s`；win32 且没有 Git Bash 时
# `scripts/run-ios.mjs` 自己就返回 skip），于是钩子放行 —— 那棵树上
# `apps/ios/RAI/HealthKitSync.swift` 带着 6 条类型错误进了主干，而 commit message
# 写的是"10 支 iOS 结构门禁全绿"。**跳过与通过共用了一个 0。**
# 所以下面加一道**认账**闸门：本机一个 iOS 判据都没跑 ⇒ 默认拒，要么去 macOS 上查，
# 要么显式认账。跑门禁本身仍然照跳（那是 `run-ios.mjs` 的既定契约，动它会连带
# 改掉 AGENTS.md 与 cross-platform-scripts.test.ts 里那两条判据）。
if git diff --cached --name-only --diff-filter=ACMR -- apps/ios | grep -q .; then
  echo "pre-commit: apps/ios/ 有改动，跑 iOS 门禁"
  ios_log="$(mktemp)"
  # `tee` 保住实时输出（这扇门要跑几分钟，静默的钩子等于没有钩子），日志留给下面判"到底查没查"。
  if ! npm run test:ios 2>&1 | tee "$ios_log"; then
    rm -f "$ios_log"
    exit 1
  fi
  # 哨兵从 Node 侧取，**不在钩子里抄第三份字符串**：`cross-platform-scripts.test.ts`
  # 正在钉"`.sh` 与 Node 两侧不漂移"，钩子里再抄一份只会多一个漂移点。
  ios_sentinel="$(node --input-type=module -e 'import { NO_IOS_SOURCE_CHECKED } from "./scripts/run-ios.mjs"; console.log(NO_IOS_SOURCE_CHECKED)')"
  if grep -qF "$ios_sentinel" "$ios_log" && [ "${RAI_IOS_UNVERIFIED:-0}" != "1" ]; then
    {
      echo ""
      echo "❌ 这台机器没有检查任何 iOS 源码（见上），但本次要提交 apps/ios/ 的改动。"
      echo "   跳过 ≠ 通过：typecheck-ios.sh 与全部 iOS 回归一道都没跑。"
      echo "   ⇒ 正解：在 macOS 上跑一次 npm run test:ios 再提交。"
      echo "   ⇒ 确认接受这次未验证提交，请显式认账：RAI_IOS_UNVERIFIED=1 git commit ..."
      echo "   ⛔ 不要改用 --no-verify：那会把 blob 上限 / typecheck / 文档引用 / 迁移冻结一起绕过。"
      echo "   📌 这次提交的 message 不许写「iOS 门禁全绿」—— 本机一个 iOS 判据都没执行。"
    } >&2
    rm -f "$ios_log"
    exit 1
  fi
  rm -f "$ios_log"
fi

# 迁移冻结校验和（`packages/storage-sqlite/src/database.ts`）的门禁：每个迁移都有冻结值、
# 冻结值仍等于转译产物、且运行与迁移都走 tsx。前两条钉的是「历史迁移没被改」，第三条钉的是
# 「TS 执行通道没被换」。2026-09-24 四组对照实测澄清：换 `node --experimental-strip-types`
# 会让 22/22 现算值漂移、让第二条变红，但**既有库仍然打得开**（运行时判定走冻结表）；
# 「换通道 ⇒ 所有库打不开」是 `342ae38` 冻结**之前**的行为。真正危险的是照第二条的报错去
# 「修复」冻结表 —— 既有库行里存的是旧冻结值，改表才让它们全部失配。
# 全量 `npm test` 依然属于手动/CICD 那一档，这里只付该文件约 40s。
# 触发面照上面的 iOS 段收窄到 `packages/storage-sqlite/`：绝大多数提交动的是别处。
if git diff --cached --name-only --diff-filter=ACMR -- packages/storage-sqlite | grep -q .; then
  echo "pre-commit: packages/storage-sqlite/ 有改动，跑迁移门禁"
  node --import tsx --test packages/storage-sqlite/test/migration-policy.test.ts
fi

# 直连写守卫的「表分类清单」必须与**迁移产物**双向一致。这条规则此前只活在
# `INGEST_TABLE_DISPOSITIONS` 的注释里，没有任何东西在守：
#   · 迁移加了表却没表态 ⇒ 运行期 installDirectSyncWriteGuards 抛错，**整条直连车道每次都被拒**
#     （direct-sync-ingest.ts 的注释里记着 2026-10-16 的实测代价：三条直连用例整批红，
#      而根因在另一个包里）；
#   · 清单留下已删表 ⇒ 「每张表都表态」这句话变成假话，而守卫对"清单有、库里没有"是静默放行。
# 判据是**跑完迁移的临时库**，不是 grep `CREATE TABLE`：v30 建临时表再 DROP+RENAME、
# 三张表被重建过两次，静态扫会假阳性。
#
# 触发面含测试与 hook 自己；`--diff-filter=ACMRD` 让"只删除"也触发（删门禁测试/迁移同样要跑）。
# 🔴 门禁跑的是**工作树**（node --test 读盘），而触发条件看的是 index：
#    这些路径若还有未暂存改动，绿只能证明工作树、不能证明即将提交的内容 ⇒ 直接拒。
GATE_PATHS="packages/storage-sqlite apps/api/src/direct-sync-ingest.ts apps/api/test/direct-sync-table-dispositions.test.ts .githooks/pre-commit"
if ! git diff --cached --quiet --diff-filter=ACMRD -- $GATE_PATHS; then
  if ! git diff --quiet -- $GATE_PATHS; then
    echo "pre-commit: 表分类门禁相关路径有未暂存改动，无法证明提交内容；先 git add 再提交" >&2
    exit 1
  fi
  echo "pre-commit: 表分类清单有改动，跑『迁移产物 ↔ 白名单』一致性门禁"
  node --import tsx --test apps/api/test/direct-sync-table-dispositions.test.ts
fi

# §16.1 验收矩阵的覆盖检查。此前"覆盖了多少条"只是一个断言：2026-09-30 实测矩阵共 54 条，
# 而按 ID 被引用的只有 19 条 —— 但"没引用"与"没覆盖"是两件事，看数字分不出来。
# 这个检查把每条判成 cited / declared-gap / missing，missing 即失败；
# 于是新增一条验收用例而不写测试、也不写缺哪一半，提交就会被拦下。
# 触发面：测试与方案文档都可能改变这个结论，所以每次提交都跑（约 0.3s）。
echo "pre-commit: 跑 §16.1 验收矩阵覆盖检查"
node --import tsx scripts/check-acceptance-matrix.mts

# §7.7-5 / §13.4 的依赖约束。这条不变量今天成立，但此前**没有任何东西在守**：
# workspace 依赖允许写 "@/rai/readiness": "*"，一旦有人加上，编译照过、测试照绿，
# 而"恢复不再影响 Fitness"这条 P0 不变量已经被悄悄破坏。
# 检查四类判据：包不得依赖 app、scoring 的具名禁线、声明↔实际一致、边集白名单。
echo "pre-commit: 跑包边界检查"
node scripts/check-package-boundaries.mjs
