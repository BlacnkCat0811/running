#!/usr/bin/env bash
# Local guard for a repository whose CI is not wired to its remote (gitee).
# Catches type regressions before commit; the full `npm run test:all` gate
# still belongs to CI / a pre-push manual run.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 仓库体积闸门：单个已跟踪文件不得超过 1.5 MB。触发面**刻意不收窄** —— 大文件可以从任何
# 目录进来，而上一轮正是「在一个目录里清掉、又在另一个新目录复发」（27 MB 的 4K 设计板）。
# 这条是路径无关的字节上限，每次提交都跑（毫秒级）。为什么用字节上限而不是 `.gitignore`
# 模式（会静默拦掉验收截图），见 scripts/check-blob-size.mjs 头注释。
node scripts/check-blob-size.mjs

npm run typecheck

# iOS 判据（typecheck-ios.sh + run-model-tests.sh）此前没有任何自动入口，
# 只有人记得的时候才会被跑 —— 2026-09-19 的 test11 回归就是这么进主干的。
# 触发面刻意收窄到 `apps/ios/`：iOS 门禁要真编译全部 Swift 源码，秒级变分钟级，
# 而绝大多数提交动的是 TS。
#
# 这里不做环境判断：`npm run test:ios` 自己会发现"非 macOS / 没有 Xcode"，
# 打印「本次没有检查任何 iOS 源码」并跳过。把判断放一处，避免两边的条件漂移。
if git diff --cached --name-only --diff-filter=ACMR -- apps/ios | grep -q .; then
  echo "pre-commit: apps/ios/ 有改动，跑 iOS 门禁"
  npm run test:ios
fi

# 迁移冻结校验和（`packages/storage-sqlite/src/database.ts`）的门禁：每个迁移都有冻结值、
# 冻结值仍等于转译产物、且运行与迁移都走 tsx。前两条钉的是「历史迁移没被改」，第三条钉的是
# 「TS 执行通道没被换」。2026-09-24 四组对照实测澄清：换 `node --experimental-strip-types`
# 会让 22/22 现算值漂移、让第二条变红，但**既有库仍然打得开**（运行时判定走冻结表）；
# 「换通道 ⇒ 所有库打不开」是 `342ae38` 冻结**之前**的行为。真正危险的是照第二条的报错去
# 「修复」冻结表 —— 既有库行里存的是旧冻结值，改表才让它们全部失配。
# 全量 `npm test` 依然属于手动/CICD 那一档，这里只付该文件约 40s。
# 触发面照上面的 iOS 段收窄到 `packages/storage-sqlite/`：绝大多数提交动的是别处。
if git diff --cached --name-only --diff-filter=ACMR -- packages/storage-sqlite | grep -q .; then
  echo "pre-commit: packages/storage-sqlite/ 有改动，跑迁移门禁"
  node --import tsx --test packages/storage-sqlite/test/migration-policy.test.ts
fi
