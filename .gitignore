# Sensitive source data and generated databases
apple_health_export/
*.zip
var/
data/private/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Rust backend build output (Cargo.lock is committed)
/target/

# Python research environments
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
.grok/
.workbuddy/

# Local outputs and temp artifacts (CA mobileconfig, exports, previews)
output/

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
*.xccheckout
*.moved-aside

# CocoaPods: the AMap SDK is vendored by `pod install` (apps/ios), never committed.
# Commit Podfile, Podfile.lock and RAI.xcworkspace/contents.xcworkspacedata instead.
apps/ios/Pods/

# AMap iOS SDK key: local only, injected into the generated Pods xcconfig by the Podfile.
# Template is committed as apps/ios/Configs/AmapKey.xcconfig.example.
apps/ios/Configs/AmapKey.xcconfig

# Generated data audit is a runtime report, not maintained project documentation
/docs/DATA_AUDIT.md

# Reproducible Xcode build/test outputs under evidence directories. Keep the
# authored report and source fixture; these directories are regenerated by the
# corresponding run-*.sh scripts and must never enter a commit.
/deliverables/**/derived/
/deliverables/**/test-derived/
/deliverables/**/*.xcresult/

# Local one-off debug scripts are not product source.
/tmp-*.mts

# Load-test / benchmark raw artifacts: large, reproducible from scripts/phase2-*.mjs,
# and not needed for source review or deployment.
/deliverables/**/evidence/*.requests.ndjson.gz
/deliverables/**/evidence/*.tar.gz
/deliverables/**/evidence/http-benchmark-*.json
/deliverables/**/evidence/series-dump-*.json
/deliverables/**/evidence/write-amplification-*.json
/deliverables/**/evidence/write-amplification-*.log
